generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String               @id @default(uuid())
  fullName           String
  email              String               @unique
  phone              String
  passwordHash       String?
  role               UserRole             @default(DONOR)
  avatarUrl          String?
  city               String               @default("Adama")
  woreda             String?
  kebele             String?
  nationalIdNumber   String?
  orgName            String?
  orgRegNumber       String?
  googleId           String?              @unique
  googleConnected    Boolean              @default(false)
  isVerified         Boolean              @default(false)
  status             String               @default("ACTIVE")
  bio                String?
  address            String?
  taxId              String?
  website            String?
  department         String?
  donorType          DonorClassification? @default(INDIVIDUAL)
  householdSize      Int?
  language           String               @default("en")
  emailNotifications Boolean              @default(true)
  smsNotifications   Boolean              @default(true)
  twoFactorEnabled   Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  requests           BeneficiaryRequest[]
  donations          Donation[]
  notifications      Notification[]

  @@map("users")
}

model BeneficiaryRequest {
  id                       String                 @id @default(uuid())
  requestNumber            String                 @unique
  beneficiaryId            String
  beneficiaryName          String
  beneficiaryPhone         String
  nationalIdNumber         String
  kebele                   String
  woreda                   String
  category                 SupportCategory
  urgency                  UrgencyLevel           @default(MEDIUM)
  title                    String
  description              String
  householdSize            Int                    @default(1)
  estimatedAmountNeededEtb Decimal                @db.Decimal(12, 2)
  amountRaisedEtb          Decimal                @default(0.00) @db.Decimal(12, 2)
  itemQuantityNeeded       String?
  itemQuantityFulfilled    String?
  status                   RequestStatus          @default(SUBMITTED)
  kebeleApprovedBy         String?
  kebeleApprovalDate       DateTime?
  woredaApprovedBy         String?
  woredaApprovalDate       DateTime?
  rejectionReason          String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  beneficiary              User                   @relation(fields: [beneficiaryId], references: [id])
  distributions            DistributionRecord[]
  donations                Donation[]
  documents                RequestDocument[]
  statusHistory            RequestStatusHistory[]

  @@map("beneficiary_requests")
}

model RequestStatusHistory {
  id        Int                @id @default(autoincrement())
  requestId String
  status    RequestStatus
  updatedBy String
  comment   String?
  updatedAt DateTime           @default(now())
  request   BeneficiaryRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("request_status_history")
}

model RequestDocument {
  id         String             @id @default(uuid())
  requestId  String
  name       String
  type       String
  url        String
  sizeKb     Int
  uploadedAt DateTime           @default(now())
  request    BeneficiaryRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("request_documents")
}

model Donation {
  id                  String               @id @default(uuid())
  donationNumber      String               @unique
  donorId             String?
  donorName           String
  donorEmail          String
  donorType           DonorClassification  @default(INDIVIDUAL)
  requestId           String?
  targetCategory      SupportCategory?
  type                DonationType         @default(MONEY)
  amountEtb           Decimal?             @db.Decimal(12, 2)
  itemsDescription    String?
  quantity            Decimal?             @db.Decimal(10, 2)
  unit                String?
  paymentMethod       PaymentMethod?
  transactionRef      String?
  status              String               @default("PENDING")
  assignedToRequestId String?
  receiptUrl          String?
  createdAt           DateTime             @default(now())
  distributions       DistributionRecord[]
  donor               User?                @relation(fields: [donorId], references: [id])
  request             BeneficiaryRequest?  @relation(fields: [requestId], references: [id])

  @@map("donations")
}

model DistributionRecord {
  id                       String             @id @default(uuid())
  distributionNumber       String             @unique
  requestId                String
  beneficiaryName          String
  beneficiaryPhone         String
  kebele                   String
  woreda                   String
  donationId               String
  itemsOrAmountDistributed String
  distributedByKebeleAdmin String
  confirmedByBeneficiary   Boolean            @default(true)
  deliveryPhotoUrl         String?
  signatureMock            String?
  receiptVerificationCode  String             @unique
  completedAt              DateTime           @default(now())
  donation                 Donation           @relation(fields: [donationId], references: [id])
  request                  BeneficiaryRequest @relation(fields: [requestId], references: [id])

  @@map("distribution_records")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO")
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model ChatBotFAQ {
  id          String   @id @default(uuid())
  question    String
  answer      String
  keywords    String[]
  category    String   @default("GENERAL")
  isActive    Boolean  @default(true)
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("chatbot_faqs")
}

model ChatConversation {
  id          String   @id @default(uuid())
  sessionId   String
  userId      String?
  question    String
  answer      String
  responseSource String @default("FAQ") // FAQ, AI, FALLBACK
  createdAt   DateTime @default(now())

  @@map("chat_conversations")
}

model AuditLog {
  id        String    @id @default(uuid())
  userId    String
  userName  String
  role      UserRole
  action    String
  module    String
  ipAddress String
  details   String
  riskLevel RiskLevel @default(LOW)
  timestamp DateTime  @default(now())

  @@map("audit_logs")
}

enum UserRole {
  DONOR
  BENEFICIARY
  KEBELE_ADMIN
  WOREDA_ADMIN
  CITY_ADMIN
  SYSTEM_ADMIN
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  UNDER_KEBELE_REVIEW
  APPROVED_BY_KEBELE
  UNDER_WOREDA_REVIEW
  APPROVED_PUBLISHED
  PARTIALLY_FUNDED
  FULLY_FUNDED
  IN_DISTRIBUTION
  COMPLETED
  REJECTED
}

enum SupportCategory {
  FOOD_SUPPLIES
  MEDICAL_HEALTH
  EDUCATION_SCHOOLING
  HOUSING_SHELTER
  CLOTHING_ESSENTIALS
  DISABILITY_ASSISTANCE
  EMERGENCY_RELIEF
  SKILL_TRAINING
}

enum UrgencyLevel {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum DonationType {
  MONEY
  PHYSICAL_ITEM
  SERVICE
}

enum PaymentMethod {
  TELEBIRR
  CBE_BIRR
  BANK_TRANSFER
  CARD
  PHYSICAL_HANDOVER
}

enum DonorClassification {
  INDIVIDUAL
  COMPANY
  NGO
  DIASPORA
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}
